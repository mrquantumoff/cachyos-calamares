#!/bin/bash
# qdrnt post-install setup. Runs inside the installed system (chroot).
# Usage: qdrnt-setup <username> [comma-separated oh-my-zsh plugins]
set -u

user="$1"
zsh_plugins_csv="${2:-}"

log() { echo "[qdrnt-setup] $*"; }

has_pkg() { pacman -Qq "$1" &>/dev/null; }

has_nvidia_gpu() {
    # Display controllers (PCI class 0x03xxxx) from vendor NVIDIA (0x10de)
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [[ -r "$dev/vendor" && -r "$dev/class" ]] || continue
        if [[ "$(<"$dev/vendor")" == "0x10de" && "$(<"$dev/class")" == 0x03* ]]; then
            return 0
        fi
    done
    return 1
}

# --- multilib: make sure it stays enabled (Steam, lib32-mangohud, ...) -------
if grep -q '^#\[multilib\]' /etc/pacman.conf; then
    log "enabling multilib"
    sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#Include/Include/}' /etc/pacman.conf
    pacman -Sy --noconfirm || log "pacman -Sy failed"
fi

# --- Docker: enable the socket and make sure the user is in the group ------
if has_pkg docker; then
    log "enabling docker"
    systemctl enable docker.socket
    getent group docker >/dev/null || groupadd --system docker
    usermod -aG docker "$user"
fi

# --- libvirt: enable the daemon, default NAT network, user in libvirt group --
if has_pkg libvirt; then
    log "enabling libvirt"
    systemctl enable libvirtd.socket
    getent group libvirt >/dev/null || groupadd --system libvirt
    usermod -aG libvirt,kvm "$user"
    # Equivalent of `virsh net-autostart default` (libvirtd isn't running in the chroot)
    if [[ -f /etc/libvirt/qemu/networks/default.xml ]]; then
        mkdir -p /etc/libvirt/qemu/networks/autostart
        ln -sf ../default.xml /etc/libvirt/qemu/networks/autostart/default.xml
    fi
    # Let virt-manager use the system connection by default
    mkdir -p /etc/profile.d
    echo 'export LIBVIRT_DEFAULT_URI="qemu:///system"' > /etc/profile.d/qdrnt-libvirt.sh
fi

# --- NVIDIA: CUDA (+ GPU support in Docker) --------------------------------
if has_nvidia_gpu; then
    log "NVIDIA GPU detected, installing CUDA"
    cuda_pkgs=(cuda)
    has_pkg docker && cuda_pkgs+=(nvidia-container-toolkit)
    if pacman -S --noconfirm --needed "${cuda_pkgs[@]}"; then
        if has_pkg nvidia-container-toolkit; then
            nvidia-ctk runtime configure --runtime=docker || log "nvidia-ctk configure failed"
        fi
    else
        log "CUDA installation failed, continuing"
    fi
else
    log "no NVIDIA GPU, skipping CUDA"
fi

# --- Flatpak: add Flathub system-wide --------------------------------------
if has_pkg flatpak; then
    log "adding flathub"
    flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo || log "flathub remote failed"
fi

# --- Helium as the default browser ------------------------------------------
if has_pkg helium-browser-bin; then
    log "setting helium as default browser"
    mkdir -p /etc/xdg
    cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
x-scheme-handler/http=helium.desktop
x-scheme-handler/https=helium.desktop
x-scheme-handler/about=helium.desktop
x-scheme-handler/unknown=helium.desktop
text/html=helium.desktop
application/xhtml+xml=helium.desktop
EOF
    mkdir -p /etc/environment.d
    echo "BROWSER=helium-browser" > /etc/environment.d/90-qdrnt-browser.conf
fi

# --- zsh: oh-my-zsh + duellj config, default for users created later --------
if [[ -x /bin/zsh ]]; then
    sed -i 's|^SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd

    if [[ -r /etc/calamares/scripts/qdrnt.zsh ]]; then
        log "installing qdrnt zsh config"
        install -Dm644 /etc/calamares/scripts/qdrnt.zsh /usr/local/share/qdrnt/qdrnt.zsh
        # Plugins picked in the installer. Unexpanded "${gs[...]}" (no selection
        # stored) means "use the qdrnt defaults" from qdrnt.zsh.
        zsh_plugins=()
        if [[ "$zsh_plugins_csv" != *'${'* ]]; then
            IFS=',' read -r -a picked <<< "$zsh_plugins_csv"
            for p in "${picked[@]}"; do
                [[ "$p" =~ ^[A-Za-z0-9_-]+$ ]] && zsh_plugins+=("$p")
            done
            plugins_line="plugins=(${zsh_plugins[*]})"
        else
            plugins_line="# plugins=(...)   # unset: qdrnt defaults from /usr/local/share/qdrnt/qdrnt.zsh"
        fi
        log "zsh plugins: ${zsh_plugins[*]:-<defaults>}"
        zshrc="# qdrnt: oh-my-zsh (duellj theme). Edit the plugin list, then open a new shell.
# Available plugins: ls /usr/share/oh-my-zsh/plugins
${plugins_line}

source /usr/local/share/qdrnt/qdrnt.zsh

# Your own settings below."
        # New users (/etc/skel/.zshrc belongs to cachyos-zsh-config; a package
        # update may restore the CachyOS version for users created afterwards).
        printf '%s\n' "$zshrc" > /etc/skel/.zshrc
        home="$(getent passwd "$user" | cut -d: -f6)"
        if [[ -n "$home" && -d "$home" ]]; then
            printf '%s\n' "$zshrc" > "$home/.zshrc"
            chown "$user": "$home/.zshrc"
        fi
    fi
fi

exit 0
